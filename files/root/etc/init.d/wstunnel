#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

validate_tunnel() {
	local value="$1"
	/usr/libexec/wstunnel-validate "$value" || { invalid=1; return; }
	tunnel_count=$((tunnel_count + 1))
}

append_tunnel() {
	procd_append_param command -L "$1"
}

start_client() {
	local section="$1" enabled server tls_verify log_level nb_worker_threads
	local invalid=0 tunnel_count=0 option value
	config_get_bool enabled "$section" enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get server "$section" server
	case "$server" in
		ws://?*|wss://?*|http://?*|https://?*) ;;
		*) logger -t wstunnel "Invalid server URL in $section"; return 1 ;;
	esac
	config_get log_level "$section" log_level INFO
	case "$log_level" in
		TRACE|DEBUG|INFO|WARN|ERROR|OFF) ;;
		*) logger -t wstunnel "Invalid log level in $section"; return 1 ;;
	esac
	config_get_bool tls_verify "$section" tls_verify 1
	config_get nb_worker_threads "$section" nb_worker_threads
	if [ -n "$nb_worker_threads" ]; then
		case "$nb_worker_threads" in
			*[!0-9]*) logger -t wstunnel "Invalid worker thread count in $section"; return 1 ;;
		esac
		case "$nb_worker_threads" in
			*[1-9]*) ;;
			*) logger -t wstunnel "Invalid worker thread count in $section"; return 1 ;;
		esac
	fi
	config_list_foreach "$section" local_forward validate_tunnel
	if [ "$invalid" = 1 ] || [ "$tunnel_count" = 0 ]; then
		logger -t wstunnel "Missing or unsupported tunnel in $section"
		return 1
	fi
	procd_open_instance "$section"
	procd_set_param command /usr/bin/wstunnel client --no-color --log-lvl "$log_level"
	[ "$tls_verify" = 1 ] && procd_append_param command --tls-verify-certificate
	[ -n "$nb_worker_threads" ] && procd_append_param command --nb-worker-threads "$nb_worker_threads"
	for option in sni path_prefix http_proxy credentials; do
		config_get value "$section" "$option"
		[ -n "$value" ] || continue
		case "$option" in
			sni) procd_append_param command --tls-sni-override "$value" ;;
			path_prefix) procd_append_param command --http-upgrade-path-prefix "$value" ;;
			http_proxy) procd_append_param command --http-proxy "$value" ;;
			credentials) procd_append_param command --http-upgrade-credentials "$value" ;;
		esac
	done
	config_list_foreach "$section" local_forward append_tunnel
	procd_append_param command "$server"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load wstunnel
	config_foreach start_client client
}

service_triggers() {
	procd_add_reload_trigger wstunnel
}
